{
  "name": "checkpoint-deck",
  "version": "1.4.0",
  "checkpointProtocol": 1,
  "description": "Plugin de Decky Loader para vincular la Steam Deck con un hub de Checkpoint",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "pytest -q",
    "package": "bash scripts/package.sh",
    "zip": "npm run build && bash scripts/package.sh"
  },
  "keywords": ["decky", "plugin", "steam-deck", "checkpoint"],
  "author": "mcondepo",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
